{
  "name": "Dental Scan Viewer",
  "short_name": "Scan Viewer",
  "description": "View upper and lower intraoral scans in occlusion, find and measure teeth, Bolton and arch analysis, printable model bases.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "any",
  "background_color": "#e9ecea",
  "theme_color": "#2f62b0",
  "categories": ["medical", "utilities"],
  "icons": [
    {"src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any"},
    {"src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any"},
    {"src": "icons/maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable"},
    {"src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable"}
  ],
  "file_handlers": [
    {"action": "./", "accept": {
      "model/stl": [".stl"],
      "application/sla": [".stl"],
      "application/ply": [".ply"],
      "model/obj": [".obj"],
      "application/octet-stream": [".stl", ".ply", ".obj"]
    }}
  ],
  "launch_handler": {"client_mode": "focus-existing"}
}
